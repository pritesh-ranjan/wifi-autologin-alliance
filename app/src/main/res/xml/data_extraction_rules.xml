<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude locally saved captive portal credentials from cloud backup -->
        <exclude domain="sharedpref" path="alliance_login_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="alliance_login_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>