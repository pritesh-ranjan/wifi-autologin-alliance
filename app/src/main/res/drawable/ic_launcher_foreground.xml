<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Wi-Fi Signal Wave -->
    <path
        android:pathData="M29,42 C36,33 44.5,28 54,28 C63.5,28 72,33 79,42"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="29"
                android:startY="35"
                android:endX="79"
                android:endY="35"
                android:type="linear">
                <item android:color="#7DD3FC" android:offset="0.0" />
                <item android:color="#FFFFFF" android:offset="0.5" />
                <item android:color="#7DD3FC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Wi-Fi Signal Wave -->
    <path
        android:pathData="M37,51 C42,44 47.5,40 54,40 C60.5,40 66,44 71,51"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="37"
                android:startY="45"
                android:endX="71"
                android:endY="45"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#E0F2FE" android:offset="0.5" />
                <item android:color="#38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Base Signal Node / Wave -->
    <path
        android:pathData="M44,61 C47,56.5 50.5,54 54,54 C57.5,54 61,56.5 64,61"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeColor="#BAE6FD" />

    <!-- Lightning Bolt Drop Shadow -->
    <path
        android:pathData="M56,32 L43.5,53 L51.5,53 L46.5,78 L64,49 L55,49 Z"
        android:fillColor="#22000000" />

    <!-- Electric Lightning Bolt (Instant Speed Login) -->
    <path
        android:pathData="M55,30 L43,51 L51,51 L46,76 L63,48 L54,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43"
                android:startY="30"
                android:endX="63"
                android:endY="76"
                android:type="linear">
                <item android:color="#FDE047" android:offset="0.0" />
                <item android:color="#F59E0B" android:offset="0.6" />
                <item android:color="#D97706" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lightning Bolt Highlight Core -->
    <path
        android:pathData="M54,32 L45.5,50 L52,50 L48.5,69 L60,49 L53.5,49 Z"
        android:fillColor="#33FFFFFF" />
</vector>